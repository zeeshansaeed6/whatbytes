{
  "info": {
    "name": "Healthcare Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "access",
      "value": ""
    },
    {
      "key": "patient_id",
      "value": ""
    },
    {
      "key": "doctor_id",
      "value": ""
    },
    {
      "key": "mapping_id",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "doctor_email",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Jane\", \"email\": \"jane{{$timestamp}}@example.com\", \"password\": \"pass12345\"}"
        },
        "url": "{{base}}/auth/register/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('email', pm.response.json().email);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('access', pm.response.json().access);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"pass12345\"}"
        },
        "url": "{{base}}/auth/login/"
      }
    },
    {
      "name": "Create patient",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"John Doe\", \"age\": 40, \"gender\": \"Male\", \"address\": \"1 Main St\", \"medical_history\": \"None\"}"
        },
        "url": "{{base}}/patients/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('patient_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List patients",
      "request": {
        "method": "GET",
        "url": "{{base}}/patients/"
      }
    },
    {
      "name": "Get patient",
      "request": {
        "method": "GET",
        "url": "{{base}}/patients/{{patient_id}}/"
      }
    },
    {
      "name": "Update patient",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"John Doe\", \"age\": 41, \"gender\": \"Male\"}"
        },
        "url": "{{base}}/patients/{{patient_id}}/"
      }
    },
    {
      "name": "Create doctor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Dr. Smith\", \"specialization\": \"Cardiology\", \"email\": \"smith{{$timestamp}}@example.com\", \"phone\": \"555-0100\"}"
        },
        "url": "{{base}}/doctors/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('doctor_id', pm.response.json().id); pm.collectionVariables.set('doctor_email', pm.response.json().email); }"
            ]
          }
        }
      ]
    },
    {
      "name": "List doctors",
      "request": {
        "method": "GET",
        "url": "{{base}}/doctors/"
      }
    },
    {
      "name": "Get doctor",
      "request": {
        "method": "GET",
        "url": "{{base}}/doctors/{{doctor_id}}/"
      }
    },
    {
      "name": "Update doctor",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Dr. Smith\", \"specialization\": \"Neurology\", \"email\": \"{{doctor_email}}\"}"
        },
        "url": "{{base}}/doctors/{{doctor_id}}/"
      }
    },
    {
      "name": "Assign doctor to patient",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"patient\": {{patient_id}}, \"doctor\": {{doctor_id}}}"
        },
        "url": "{{base}}/mappings/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('mapping_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List mappings",
      "request": {
        "method": "GET",
        "url": "{{base}}/mappings/"
      }
    },
    {
      "name": "Doctors of patient",
      "request": {
        "method": "GET",
        "url": "{{base}}/mappings/{{patient_id}}/"
      }
    },
    {
      "name": "Delete mapping",
      "request": {
        "method": "DELETE",
        "url": "{{base}}/mappings/{{mapping_id}}/"
      }
    },
    {
      "name": "Delete doctor",
      "request": {
        "method": "DELETE",
        "url": "{{base}}/doctors/{{doctor_id}}/"
      }
    },
    {
      "name": "Delete patient",
      "request": {
        "method": "DELETE",
        "url": "{{base}}/patients/{{patient_id}}/"
      }
    }
  ]
}